# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Default Font for Sway UI (Titles, Bars, etc.)
font pango:IBM Plex Sans SmBld 10

# Default Cursor Theme
set $cursor_theme breeze_cursors
set $cursor_size 24
seat * xcursor_theme $cursor_theme $cursor_size

# Sync cursor theme to GTK apps and D-Bus for startup notifications
exec_always {
    gsettings set org.gnome.desktop.interface cursor-theme $cursor_theme
    gsettings set org.gnome.desktop.interface cursor-size $cursor_size
    gsettings set org.gnome.desktop.sound theme-name "Pop"
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
    gsettings set org.gnome.desktop.interface icon-theme TokyoNight-SE
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
    gsettings set org.gnome.desktop.interface font-name 'IBM Plex Sans SmBld 10'
    gsettings set org.gnome.desktop.interface monospace-font-name 'FiraCode Nerd Font 10'
    dbus-update-activation-environment --systemd GTK_THEME=adw-gtk3-dark XCURSOR_THEME=$cursor_theme XCURSOR_SIZE=$cursor_size
}

# Remove titlebars (top text) and use a clean 2-pixel border instead
default_border pixel 2px
default_floating_border pixel 2px

# class                 border  bground text    indicator child_border
client.focused          #bb9af7 #bb9af7 #1a1b26 #bb9af7   #bb9af7
client.focused_inactive #414868 #414868 #c0caf5 #bb9af7   #414868
client.unfocused        #24283b #24283b #a9b1d6 #bb9af7   #24283b
client.urgent           #f7768e #f7768e #c0caf5 #bb9af7   #f7768e
client.placeholder      #bb9af7 #bb9af7 #1a1b26 #bb9af7   #bb9af7

# SwayFX Enhancements (Vibrancy, Blur, and Depth)
# --- SwayFX Settings (Disabled for Intel Haswell Compatibility) ---
# blur enable
# blur_passes 3
# shadows enable
# corner_radius 820
shadow_color #15161ecc
for_window [tiling] dim_inactive 0.15
for_window [floating] dim_inactive 0.15

# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty

set $file_explorer thunar
# Your preferred web browser
set $browser zen-browser

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
# Use swaybg explicitly instead of output * bg to bypass native renderer bugs
exec_always sh -c 'killall swaybg; swaybg -i ~/Pictures/wallpapers/active_wallpaper.png -m fill'
# Dell Inspiron 3542 Display Settings (1366x768)
output eDP-1 resolution 1366x768 position 0,0 scale 1
# Fallback for any other display
output * scale 1
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

gaps inner 2px
gaps outer 1px

### Idle configuration
#
# KDE-style aggressive power management:
exec_always ~/.config/sway/idle.sh

### Input configuration
#
# Example configuration:

    input type:touchpad {
            dwt enabled
            tap enabled
            natural_scroll enabled
            middle_emulation enabled
    }

    # Hold middle-click (scroll wheel) and move mouse to scroll
    input type:pointer {
    scroll_method on_button_down
    natural_scroll enabled
}

# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+q kill

    # Start Quickshell Application Launcher
    bindsym $mod+d exec qs ipc call launcher toggle

    # Start the file explorer
    bindsym $mod+e exec $file_explorer

    # Start the system monitor
    bindsym $mod+Escape exec $term -e btop

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway / Open Quickshell Power Menu
    bindsym $mod+Shift+e exec qs ipc call power toggle
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

    # Switch workspaces with mouse side buttons (Forward/Back)
    bindsym --whole-window button9 workspace next_on_output
    bindsym --whole-window button8 workspace prev_on_output
#
# Layout stuff:
#
    # Open Browser
    bindsym $mod+b exec $browser
    bindsym $mod+z exec zeditor
    bindsym $mod+Shift+z exec zeditor -n

    # Quickshell Integrated Clipse Clipboard Picker
    bindsym $mod+v exec qs ipc call clipboard toggle

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout toggle tabbed splith

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities & Hardware Controls:
#
    # Special keys to adjust volume via PulseAudio/PipeWire
    bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
    bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

    # Special keys to control media via playerctl
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioStop exec playerctl stop

    # Special keys to adjust brightness via Quickshell helper
    bindsym --locked XF86MonBrightnessDown exec ~/.config/quickshell/scripts/brightness.sh step_down 5%
    bindsym --locked XF86MonBrightnessUp exec ~/.config/quickshell/scripts/brightness.sh step_up 5%
    # Restore brightness on startup
    exec ~/.config/quickshell/scripts/brightness.sh restore

    # Screenshots
    bindsym $mod+Shift+s exec ~/.config/sway/screenshot.sh region
    bindsym Print exec qs ipc call screenshot toggle
    bindsym $mod+Print exec ~/.config/sway/screenshot.sh full

    # Screen Recording (Quickshell Recorder Menu)
    bindsym $mod+Shift+r exec qs ipc call recorder toggle

    # Quickshell Notification Center Toggle
    bindsym $mod+n exec qs ipc call notifications toggle

    # Quickshell Emoji Picker
    bindsym $mod+period exec qs ipc call emoji toggle

# ── Quickshell Desktop Environment Autostart ──
exec_always sh -c 'pkill -x qs; pkill -x quickshell; qs'

# Sync environment variables to D-Bus for GTK apps
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
# Start the Sway session target to satisfy xdg-desktop-portal dependencies for Wayland screensharing
exec systemctl --user start sway-session.target
include /etc/sway/config.d/*

# Run autotiling to automatically create spiral/dwindle layouts
exec_always autotiling

# Polkit Authentication Agent (Required for GUI root password prompts)
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Clipse Clipboard Manager Daemon
exec wl-paste --type text --watch clipse -wl-store
exec wl-paste --type image --watch clipse -wl-store

# --- Idle Inhibition & Media Rules ---
# Prevent screen sleep while any audio is playing
exec_always sh -c 'pkill -x sway-audio-idle-inhibit; sway-audio-idle-inhibit'

# Automatically prevent screen sleep whenever ANY application goes fullscreen (e.g., YouTube video)
for_window [class=".*"] inhibit_idle fullscreen
for_window [app_id=".*"] inhibit_idle fullscreen

# Window Rules
for_window [app_id="swappy"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set width 450 px height 265 px, move position 875 0
for_window [app_id="clipse"] floating enable, resize set width 800 px height 600 px, move position center
